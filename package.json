{
  "name": "eloforge",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first chess trainer PWA: openings, tactics and endgames from 900 to 2000 Elo.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "engine": "node scripts/copy-engine.mjs",
    "dev": "npm run engine && vite",
    "build": "npm run engine && tsc --noEmit && vite build",
    "preview": "vite preview",
    "validate": "node scripts/validate-content.mjs",
    "content:setup": "npm install --no-save stockfish@18.0.8",
    "continuations": "node scripts/gen-continuations.mjs",
    "continuations:check": "node scripts/check-continuations.mjs"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "peerjs": "1.5.5",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
